#!/usr/bin/env ruby

print "Booting application..."
$stdout.flush
ENV["SECRET_KEY_BASE"] = `bin/rails secret`
ENV["RAILS_ENV"] = "production"
require_relative "../config/environment"
puts " done."

Rails.application.ractor_shareable!
raise unless Ractor.shareable?(Rails.application)

require "cougar"
require "rack"

# Load the Rack app from config.ru
app, _options = Rack::Builder.parse_file("config.ru")

# Start the server (uses RUBY_MAX_CPU env var or defaults to 8 workers)
ENV["RUBY_MAX_CPU"] = "1"
server = Cougar::Server.new(app, host: "0.0.0.0", port: 9292)

proc do
  puts "\nShutting down..."
  server.stop
  exit
end
  .then do
    trap("INT", &it)
    trap("TERM", &it)
  end

server.run
